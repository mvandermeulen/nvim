  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "zsh ~/.claude/hooks/claude-activity-tracker.sh notification",
            "async": true,
            "timeout": 2
          },
          {
            "type": "command",
            "command": "zsh .claude/scripts/notify.sh",
            "async": true,
            "timeout": 2
          },
          {
            "type": "command",
            "command": "uv run .claude/hooks/coordinator.py notification",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "zsh ~/.claude/hooks/claude-activity-tracker.sh stop",
            "async": true,
            "timeout": 2
          },
          {
            "type": "command",
            "command": "uv run .claude/hooks/coordinator.py stop",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "zsh ~/.claude/hooks/claude-activity-tracker.sh stop",
            "async": true,
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session-init.sh",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "uv run .claude/hooks/coordinator.py session-start",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "zsh ~/.claude/hooks/claude-activity-tracker.sh stop",
            "async": true,
            "timeout": 2
          },
          {
            "type": "command",
            "command": "uv run .claude/hooks/coordinator.py session-end",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "zsh ~/.claude/hooks/claude-activity-tracker.sh stop",
            "async": true,
            "timeout": 2
          },
          {
            "type": "command",
            "command": "uv run .claude/hooks/coordinator.py pre-tool-use",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/coordinator.py post-tool-use",
            "async": true,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "uv run .claude/scripts/when/post/post_tool_use.py",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "zsh ~/.claude/hooks/claude-activity-tracker.sh stop",
            "async": true,
            "timeout": 2
          },
          {
            "type": "command",
            "command": "uv run .claude/hooks/coordinator.py subagent-stop",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "zsh ~/.claude/hooks/claude-activity-tracker.sh stop",
            "async": true,
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/message-counter.sh",
            "async": true,
            "timeout": 2
          },
          {
            "type": "command",
            "command": "uv run .claude/hooks/session-checklist.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "uv run .claude/hooks/coordinator.py user-prompt-submit",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "preferences": {
    "codeStyle": {
      "indentation": "2 spaces",
      "semicolons": true,
      "quotes": "single",
      "trailingCommas": true
    },
    "git": {
      "commitStyle": "conventional",
      "branchNaming": "feature/description",
      "autoStage": false
    }
  },
  "enableAllProjectMcpServers": false,
  "forceLoginMethod": "claudeai",
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 1000,
  "alwaysThinkingEnabled": true,
  "autoUpdates": false,
  "theme": "dark"
}
